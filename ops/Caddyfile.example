# Operator-reviewed HTTPS VM template. Replace this reserved placeholder host.
# Do not run/apply without hosting, DNS, identity and data-handling approval.
maintenance.example.invalid {
    request_body {
        max_size 8MB
    }
    reverse_proxy 127.0.0.1:8787
    # Application sets CSP, framing, no-store, HSTS and authorization headers.
    # Do not overwrite them or add a wildcard frame/CORS policy.
    # No access log is configured: callback URLs can contain short-lived codes.
}
