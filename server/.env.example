# Server-only configuration template. No real credentials are included.
# Load via: node --env-file=/etc/tpm/server.env build-server/index.mjs
NODE_ENV=production
TPM_APP_ORIGIN=https://maintenance.example.invalid
PORT=8787
TPM_DATA_DIRECTORY=/var/lib/tpm-command-center
TPM_STORAGE_KEY_FILE=/run/secrets/tpm-storage-key
TPM_USERS_FILE=/etc/tpm/staff-subjects.json
TPM_OIDC_ISSUER=https://identity.example.invalid
TPM_OIDC_CLIENT_ID=replace-with-reviewed-identity-client-id
# Only when the reviewed OIDC client uses a confidential client secret:
# TPM_OIDC_CLIENT_SECRET_FILE=/run/secrets/tpm-oidc-client-secret
TPM_OIDC_ALLOWED_ORIGINS=https://identity.example.invalid
# Exact HTTPS ancestor origins only; blank defaults to frame-ancestors 'none'.
TPM_FRAME_ANCESTORS=
# Processing is OFF until a server operator and an administrator enable both gates.
TPM_ALLOW_SCHEDULED_CSV=false
# TPM_CSV_INBOX=/var/lib/tpm-command-center/inbox
# LOCAL SYNTHETIC TESTING ONLY: cannot enable HTTP mode with NODE_ENV=production.
# TPM_LOCAL_HTTP=1
# No Rentvine credentials, endpoints or API enable switch are supported in this phase.
# Phase 7: choose Google Workspace only after company identity approval.
TPM_AUTH_PROVIDER=oidc
# For google_workspace, set the exact reviewed organization domain (no wildcard).
# TPM_GOOGLE_WORKSPACE_DOMAIN=approved-workspace.example
# Loopback for a VM + local proxy; explicit 0.0.0.0 only inside a protected host/container.
TPM_BIND_ADDRESS=127.0.0.1
