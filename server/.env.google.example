# PREPARATION ONLY. No live client or secret is supplied/activated.
# Review docs/GOOGLE_WORKSPACE.md and actual provider metadata before use.
NODE_ENV=production
PORT=8787
TPM_BIND_ADDRESS=127.0.0.1
TPM_APP_ORIGIN=https://maintenance.example.invalid
TPM_AUTH_PROVIDER=google_workspace
TPM_GOOGLE_WORKSPACE_DOMAIN=approved-workspace.example
TPM_OIDC_ISSUER=https://accounts.google.com
TPM_OIDC_CLIENT_ID=replace-with-approved-web-client-id
TPM_OIDC_CLIENT_SECRET_FILE=/run/secrets/tpm-oidc-client-secret
# Check these origins against the approved issuer's actual discovery document.
TPM_OIDC_ALLOWED_ORIGINS=https://accounts.google.com,https://oauth2.googleapis.com,https://www.googleapis.com
TPM_USERS_FILE=/etc/tpm/staff-subjects.json
TPM_STORAGE_KEY_FILE=/run/secrets/tpm-storage-key
TPM_DATA_DIRECTORY=/var/lib/tpm-command-center
# Leave denied until the actual Team Portal ancestor chain is reviewed.
TPM_FRAME_ANCESTORS=
TPM_ALLOW_SCHEDULED_CSV=false
# TPM_CSV_INBOX=/var/lib/tpm-command-center/inbox
